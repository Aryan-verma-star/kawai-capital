# KAVACH environment — copy to .env and fill in what you have.
# Everything is OPTIONAL: with zero keys the app runs fully on deterministic
# fallbacks (dictionary radar, optimizer-only proposals, REPLAY LAB complete).

# Google Gemini (all four AI roles: radar, advisor, critic, narrator)
GEMINI_API_KEY=
# Any model your key can reach; 2.5 Flash is the free-tier default,
# gemini-3-flash also works if available to your key.
GEMINI_MODEL=gemini-2.5-flash

# Optional keyed news providers (zero-key Google News RSS + GDELT are always on)
GNEWS_API_KEY=
MARKETAUX_API_KEY=
FINNHUB_API_KEY=

# Hard daily cap on AI calls (persisted counter; exceeded → dictionary mode)
MAX_AI_CALLS_PER_DAY=150

# SQLite file (local) or Turso URL (Vercel) — see docs/DEPLOY.md
DATABASE_URL=file:./db/custom.db

# Optional: protects /api/cron/news when deploying publicly
CRON_SECRET=
