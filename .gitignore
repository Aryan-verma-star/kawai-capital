# dependencies
node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# secrets — never commit keys (see SECURITY.md)
.env
.env.*
!.env.example

# operational data: SQLite DBs and the flight-recorder evidence trail
db/
data/

# logs
*.log

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# prisma generated client (regenerated on install)
src/generated/

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling artifacts
download/

# sandbox scaffolding (not part of the shipped app)
tool-results/
skills/
examples/
.zscripts/
